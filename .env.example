# --- Database ---
POSTGRES_USER=ms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ms_analytics
# Used when running the API outside Docker (db is published on host port 5434)
DATABASE_URL=postgresql+psycopg://ms:change-me@localhost:5434/ms_analytics

# --- Auth ---
ENVIRONMENT=development
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
# Used only by `python -m app.seed.users` to create local demo users (admin/manager/viewer@example.com)
DEMO_USER_PASSWORD=change-me-demo-password
SCHEDULER_ENABLED=false

# --- Google Drive / Sheets (see README, "Connect Google Drive") ---
# Preferred: service-account JSON (put it in ./secrets/, never commit it) and share the folder with its client_email.
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/service-account.json
# Fallback: an API key. Drive API keys can only read items shared "Anyone with the link".
GOOGLE_API_KEY=
# ID of the Drive root folder ("MSS Input Directory") and, for old-style links, its resource key
DRIVE_ROOT_FOLDER_ID=
DRIVE_ROOT_RESOURCE_KEY=
# "mock" = use seeded data, "drive" = live sync
DATA_SOURCE=mock

# --- Sync ---
SYNC_INTERVAL_MINUTES=10
